{
    "manifest_version": 3,
    "name": "Instant Translate Selection",
    "version": "0.1.0",
    "description": "Traduisez instantanément le texte sélectionné sans quitter la page.",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_icon": {}
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}