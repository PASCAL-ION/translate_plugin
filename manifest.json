{
    "manifest_version": 3,
    "name": "Instant Translate Selection",
    "version": "0.1.0",
    "description": "Traduisez instantanément le texte sélectionné sans quitter la page.",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "action": {
        "default_icon": "icons/language-solid-full.svg"
    },
    "icons": {
        "16": "icons/language-solid-full.svg",
        "32": "icons/language-solid-full.svg",
        "48": "icons/language-solid-full.svg",
        "128": "icons/language-solid-full.svg"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/language-solid-full.svg"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}